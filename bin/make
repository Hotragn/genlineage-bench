#!/usr/bin/env python3
"""Minimal make shim (box has no make): runs recipe lines of a named target in ./Makefile."""
import subprocess, sys
target = sys.argv[1] if len(sys.argv) > 1 else None
lines = open("Makefile").read().splitlines()
recipes, cur, order = {}, None, []
for l in lines:
    if l and not l.startswith("\t") and ":" in l:
        cur = l.split(":")[0].strip(); recipes[cur] = []; order.append(cur)
    elif l.startswith("\t") and cur:
        recipes[cur].append(l[1:])
target = target or (order[0] if order else None)
if target not in recipes:
    print(f"make: *** No rule to make target '{target}'.  Stop."); sys.exit(2)
for cmd in recipes[target]:
    print(cmd); r = subprocess.run(cmd, shell=True)
    if r.returncode: print(f"make: *** [Makefile: {target}] Error {r.returncode}"); sys.exit(2)
